@model DeliveryArea
@{
    ViewData["Title"] = "Edit Delivery Area";
}
<h1>Edit Delivery Area</h1>

<div class="col-md-6">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DeliveryFee" class="form-label">Delivery fee (R)</label>
            <input asp-for="DeliveryFee" class="form-control" />
            <span asp-validation-for="DeliveryFee" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-controller="Settings" class="btn btn-secondary">Cancel</a>
    </form>
</div>
