@{
    ViewData["Title"] = "Admin Login";
    Layout = "_AdminLoginLayout";
}

<div class="admin-login-card">
    <div class="text-center mb-2">
        <img src="~/images/koolstoof-lockup.svg" alt="Koolstoof" style="height: 60px; max-width: 100%;" />
    </div>
    <h1 class="text-center">Koolstoof Admin</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-controller="Admin" asp-action="Login" method="post">
        <div class="mb-3">
            <label class="form-label">Admin ID</label>
            <input type="text" name="adminId" class="form-control" autocomplete="username" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>
</div>
