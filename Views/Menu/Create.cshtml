@model MenuItem
@{
  ViewData["Title"] = "Add Menu Item";
}

<h1>Add Menu item</h1>

<form asp-action="Create" method="post">
		<div> 
			<label asp-for="Name"></label>
			<input asp-for="Name" />
		<span asp-validation-for="Name"></span>
		</div>
		
		<div>
			<label asp-for="Description"></label>
			<input asp-for="Description" />
			<span asp-validation-for="Description"></span>
		</div>
		
		<div>
			<label asp-for="Price"></label>
			<input asp-for="Price" />
			<span asp-validation-for="Price"></span>
		</div>
		<div>
			<label asp-for="ImageUrl"></label>
			<input asp-for="ImageUrl" />
			<span asp-validation-for="ImageUrl"></span>
		</div>

		<div>
			<label asp-for="IsInStock"></label>
			<input asp-for="IsInStock" />
			<span asp-validation-for="IsInStock"></span>
		</div>

		<div>
			<label asp-for="IsSpecial"></label>
			<input asp-for="IsSpecial" />
			<span asp-validation-for="IsSpecial"></span>
		</div>
		
		<div>
			<label asp-for="SpecialPrice"></label>
			<input asp-for="SpecialPrice" />	
			<span asp-validation-for="SpecialPrice"></span>
			</div>

		<div>
			<label asp-for="CategoryId"></label>
			<select asp-for="CategoryId" asp-items="ViewBag.Categories">
			<option value="">-- Select a category --</option>
			</select>
			<span asp-validation-for="CategoryId"></span>	
		</div>	
	
		<button type="submit">Add Menu Item</button>
	</form>