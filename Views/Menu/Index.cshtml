@model List<MenuCategory>

@{
    ViewData["Title"] = "Menu";
}

<h1>Menu</h1>

<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-4" id="cat-@category.Id">
            <div class="card mb-3">
                @if (!string.IsNullOrEmpty(category.ImageUrl))
                {
                    <div class="category-hero" style="background-image: url('@category.ImageUrl');">
                        <div class="category-hero-overlay"></div>
                        <div class="category-hero-content">
                            <span class="category-hero-name">@category.Name</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header">
                        <strong>@category.Name</strong>
                    </div>
                }
                <ul class="list-group list-group-flush">
                    @foreach (var item in category.MenuItems)
                    {
                        <li class="list-group-item" id="item-@item.Id">
                            <div>
                                <strong>@item.Name</strong>
                                @if (item.IsSpecial && item.SpecialPrice.HasValue && item.IsSitDownSpecial)
                                {
                                    <span> - @($"R{item.Price}")</span>
                                    <div><small class="text-muted">@($"Sit-down special: R{item.SpecialPrice} (in-store only, not applied to delivery orders)")</small></div>
                                }
                                else if (item.IsSpecial && item.SpecialPrice.HasValue)
                                {
                                    <span> - <s>@($"R{item.Price}")</s> @($"R{item.SpecialPrice} (Special)")</span>
                                }
                                else
                                {
                                    <span> - @($"R{item.Price}")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div><small>@item.Description</small></div>
                            }

                            @if (!item.IsInStock)
                            {
                                <span class="text-muted">Out of stock</span>
                            }
                            else if (!item.IsDeliverable)
                            {
                                <span class="text-muted">Sit-down only &mdash; not available for delivery</span>
                            }
                            else
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="mt-1">
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    @foreach (var group in item.OptionGroups.OrderBy(g => g.DisplayOrder).ThenBy(g => g.Id))
                                    {
                                        <fieldset class="item-options">
                                            <legend>@group.Name @(group.IsRequired ? "" : "(optional)")</legend>
                                            @if (!group.IsRequired)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="choice_@group.Id" id="c-@group.Id-none" value="" checked />
                                                    <label class="form-check-label" for="c-@group.Id-none">None</label>
                                                </div>
                                            }
                                            @foreach (var choice in group.Choices.OrderBy(c => c.DisplayOrder).ThenBy(c => c.Id))
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="choice_@group.Id" id="c-@choice.Id" value="@choice.Id" @(group.IsRequired ? "required" : "") />
                                                    <label class="form-check-label" for="c-@choice.Id">
                                                        @choice.Name
@if (choice.ExtraPrice > 0)
                                                        {
                                                            <span class="text-muted"> (+@($"R{choice.ExtraPrice:0.00}"))</span>
                                                        }
                                                    </label>
                                                </div>
                                            }
                                        </fieldset>
                                    }
                                    <div class="d-flex align-items-center mt-2">
                                        <input type="number" name="quantity" value="1" min="1" style="width: 60px;" class="form-control form-control-sm me-2" />
                                        <button type="submit" class="btn btn-sm btn-primary">Add to Cart</button>
                                    </div>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
