@model MenuItem
@{
	ViewData["Title"] = "Delete Menu Item";
}
<h1>Delete Menu Item</h1>
<div>
<strong> @Model.Name</strong> - R @($"{Model.Price} ({Model.Category.Name})")
</div>
@if (ViewBag.HasOrderHistory)
{
    <p>This item has already been ordered by customers, so it can't be deleted &mdash; deleting it would corrupt past order records. Mark it out of stock instead if it's no longer available.</p>
    <a asp-action="Manage" class="btn btn-secondary">Back to Menu</a>
}
else
{
    <p>Are you sure you want to delete this menu item?</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
    </form>
}
