@model MenuCategory

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<div>
    <strong>@Model.Name</strong>
</div>

@if (Model.IsUncategorized)
{
    <p>This is the built-in "Uncategorized" bucket &mdash; it can't be deleted.</p>
    <a asp-action="Manage" asp-controller="Menu" class="btn btn-secondary">Back to Menu</a>
}
else
{
    @if (ViewBag.ItemCount > 0)
    {
        <p>This category has @ViewBag.ItemCount item(s) in it. Deleting it won't delete those items &mdash; they'll be moved to <strong>Uncategorized</strong> instead. Items in Uncategorized are hidden from customers until you give them a real category again.</p>
    }
    else
    {
        <p>Are you sure you want to delete this category?</p>
    }
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Manage" asp-controller="Menu" class="btn btn-secondary">Cancel</a>
    </form>
}
