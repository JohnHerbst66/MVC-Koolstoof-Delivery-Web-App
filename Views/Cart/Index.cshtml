@model List<CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<h1>Your Cart</h1>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">Browse the menu</a>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Line total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <td>@line.Name
@if (!string.IsNullOrEmpty(line.Choices))
                        {
                            <div class="line-choices">@line.Choices</div>
                        }</td>
                    <td>@($"R{line.Price}")</td>
                    <td>
                        <div class="qty-adjuster">
                            <form asp-controller="Cart" asp-action="AdjustQuantity" method="post">
                                <input type="hidden" name="lineKey" value="@line.LineKey" />
                                <input type="hidden" name="delta" value="-1" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" @(line.Quantity <= 1 ? "disabled" : "")>&minus;</button>
                            </form>
                            <span>@line.Quantity</span>
                            <form asp-controller="Cart" asp-action="AdjustQuantity" method="post">
                                <input type="hidden" name="lineKey" value="@line.LineKey" />
                                <input type="hidden" name="delta" value="1" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">&plus;</button>
                            </form>
                        </div>
                    </td>
                    <td>@($"R{line.LineTotal}")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="lineKey" value="@line.LineKey" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <h3>@($"Total: R{Model.Sum(c => c.LineTotal)}")</h3>

    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">Proceed to Checkout</a>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-secondary">Keep browsing</a>
}
