@model List<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Orders</h1>
    <a asp-action="Hidden" class="btn btn-sm btn-outline-secondary">Hidden orders (@ViewBag.HiddenCount)</a>
</div>

@if (TempData["OrderMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["OrderMessage"]</div>
}

<div class="row">
    @foreach (var status in new[] { OrderStatus.Incoming, OrderStatus.Received, OrderStatus.OutForDelivery, OrderStatus.Delivered })
    {
        var ordersInStatus = Model.Where(o => o.Status == status).ToList();
        <div class="col-md-3 mb-4">
            <div class="order-lane">
                <h4 class="order-lane-heading">@status <span class="badge bg-secondary">@ordersInStatus.Count</span></h4>

                @if (status == OrderStatus.Delivered && ordersInStatus.Any())
                {
                    <a asp-action="ClearDelivered" class="btn btn-sm btn-outline-secondary mb-3">Clear delivered&hellip;</a>
                }

                @if (!ordersInStatus.Any())
                {
                    <p class="text-muted small">No orders here right now.</p>
                }

                @foreach (var order in ordersInStatus)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Order #@order.Id</h6>
                            <p class="mb-1">@order.CustomerName<br />@order.CustomerPhone</p>
                            <p class="mb-1"><small>@order.DeliveryArea.Name</small></p>
                            <ul class="list-unstyled small">
                                @foreach (var line in order.OrderItems)
                                {
                                    <li>@line.Quantity x @line.MenuItemName
@if (!string.IsNullOrEmpty(line.Choices))
                                    {
                                        <div class="line-choices">@line.Choices</div>
                                    }</li>
                                }
                            </ul>
                            <p class="mb-1"><strong>@($"R{order.Total}")</strong></p>
                            <p class="mb-1"><small>@order.PaymentMethod @(order.IsPaid ? "(Paid)" : "(Unpaid)")</small></p>
                            <p class="mb-2"><small>@order.PlacedAt.ToString("dd MMM HH:mm")</small></p>

                            @if (order.Status != OrderStatus.Delivered)
                            {
                                <form asp-controller="Order" asp-action="Advance" asp-route-id="@order.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        @(order.Status switch
                                        {
                                            OrderStatus.Incoming => "Mark Received",
                                            OrderStatus.Received => "Send Out for Delivery",
                                            OrderStatus.OutForDelivery => "Mark Delivered",
                                            _ => "Advance"
                                        })
                                    </button>
                                </form>
                            }
                            <a asp-action="Remove" asp-route-id="@order.Id" class="d-block small mt-2">Hide or delete&hellip;</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
